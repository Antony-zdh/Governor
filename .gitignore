# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/
.DS_Store

benchmark-output/
tmp/

# deer-inspired online dev: runtime (smoke/logs) not committed; formal results ARE committed
benchmark/FalseConsensus/results/deer_inspired/online_dev/runtime/
.runlogs/

# DEER cap-30 confidence bank: commit packed data/manifests, not resumable
# per-problem runtime files or endpoint/shard logs.
benchmark/FalseConsensus/results/related_work/deer_confidence_bank_cap30/**/trials/
benchmark/FalseConsensus/results/related_work/deer_confidence_bank_cap30/_runtime/

# DEER cap-30 confidence bank (held-out 32B + Llama-8B, test seeds 45/46/47):
# commit packed archives/manifests, not resumable per-problem runtime or logs.
benchmark/FalseConsensus/results/related_work/deer_confidence_bank_cap30_heldout/**/trials/
benchmark/FalseConsensus/results/related_work/deer_confidence_bank_cap30_heldout/_runtime/

# TJE top-1..top-6 readout bank: commit deterministic archives/manifests,
# not resumable per-problem readouts or endpoint/shard logs.
benchmark/FalseConsensus/results/related_work/tje_threshold_readout_bank_top1_6/**/readouts/
benchmark/FalseConsensus/results/related_work/tje_threshold_readout_bank_top1_6/**/triggers/
benchmark/FalseConsensus/results/related_work/tje_threshold_readout_bank_top1_6/_runtime/

