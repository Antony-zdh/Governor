    "deepseek": {"policy": "avg1", "aggregation": "arithmetic_mean", "trial_stop": [" }", "}\n", "}\n\n", "}.", "}.\n", "}\\", "}}", ")}", ")}.", ")}\n"], "require_think_close": false},
    "qwen3": {"policy": "avg2", "aggregation": "geometric_mean", "trial_stop": ["</think>"], "require_think_close": true, "note": "confidence returned only if last generated token is </think>, else 0.0"}
